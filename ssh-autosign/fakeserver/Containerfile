FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y openssh-server && \
    mkdir /var/run/sshd && \
    useradd -m -s /bin/bash enriquez && \
    echo "enriquez:$(< /dev/urandom tr -dc 'A-Za-z0-9' | head -c 16)" | chpasswd

ADD sshd_config /etc/ssh/

ENTRYPOINT ["/usr/sbin/sshd", "-D", "-e"]
